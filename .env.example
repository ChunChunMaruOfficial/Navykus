# Navykus Production Environment Variables
# Copy to .env and fill in all values

# REQUIRED - Application
NODE_ENV=production
API_PORT=4000
SERVER_URL=https://navykus.online
CORS_ORIGIN=https://navykus.online

# REQUIRED - Payload CMS
PAYLOAD_SECRET=generate-with-openssl-rand-base64-32
PAYLOAD_PUBLIC_SERVER_URL=https://navykus.online

# REQUIRED - Database (PostgreSQL for production)
# SQLite (file:./payload.db) ONLY for development
DATABASE_URL=postgresql://user:pass@host:5432/navykus?sslmode=require

# REQUIRED - Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@navykus.org
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@navykus.org
SMTP_FROM_NAME=Navykus
SMTP_SKIP_VERIFY=true

# Admin user (created on first run via seed)
ADMIN_EMAIL=admin@navykus.org
ADMIN_PASSWORD=secure-random-password

# Optional - Machine Translation
# google uses the public no-key translate endpoint; it is free but unofficial and has no SLA.
# mymemory works without a key but has public free-tier limits.
# libretranslate can point to your own LibreTranslate instance.
TRANSLATION_PROVIDER=google
GOOGLE_TRANSLATE_URL=https://translate.googleapis.com/translate_a/single
MYMEMORY_TRANSLATE_URL=https://api.mymemory.translated.net/get
MYMEMORY_EMAIL=admin@navykus.org
LIBRETRANSLATE_URL=https://libretranslate.com/translate
LIBRETRANSLATE_API_KEY=

# Optional - Translation worker
TRANSLATION_WORKER_ENABLED=true
TRANSLATION_WORKER_INTERVAL_MS=30000
TRANSLATION_WORKER_BATCH_SIZE=3
TRANSLATION_WORKER_MAX_ATTEMPTS=5
TRANSLATION_WORKER_STALE_MS=900000

# One-off admin reset script only. Do not commit real passwords.
PRIMARY_ADMIN_PASSWORD=replace-with-secure-password
